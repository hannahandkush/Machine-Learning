.DS_Store
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Exclude large data files
data/hdf5/
data/raw/
*.h5
*.tif
*.gpkg
*.pdf

# Model weights, code, and archives — kept local only (1.3 GB, files exceed
# GitHub's 100 MB limit; weights are re-downloadable from Zenodo/SharePoint)
models/

# Generated inference outputs (prediction rasters, run logs, manifests) —
# reproducible by running `python -m inference.run`, so kept local.
outputs/
documents/.Rhistory
archive/

# Local machine-specific config overrides, incl. Copernicus Data Space
# Ecosystem (CDSE) OAuth client_id/client_secret — never commit credentials.
config.local.yaml

# Cached Sentinel-2 chips fetched from the CDSE Process API (see
# utils/sentinel_hub.py) — re-fetchable, kept local only.
data/cache/sentinel2/
